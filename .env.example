# Matchbook settings. Fill in section 1; sections 2 and 3 are optional.
# Every other setting has a sensible default (see the Settings table in README.md).

# 1. AI: a Google AI Studio key (or put ANTHROPIC_API_KEY= instead to use Claude).
GOOGLE_API_KEY=
# Optional. Empty means gemini-3.6-flash, with gemini-3.5-flash-lite as the backup when it is busy.
MATCHBOOK_MODEL=

# 2. Email: the Gmail account the app uses, and its 16-character app password.
MATCHBOOK_MAIL_ADDRESS=
MATCHBOOK_MAIL_APP_PASSWORD=
# Your own address: receives the notes meant for purchase order owners.
MATCHBOOK_PROCUREMENT_EMAIL=

# 3. Supabase: keeps runs and invoice files across restarts.
# Connect > Session pooler > URI, with [YOUR-PASSWORD] replaced by the database password.
DATABASE_URL=""
# Project Settings > Data API > Project URL.
SUPABASE_URL=
# Project Settings > API Keys > a secret key (or the legacy service_role key).
SUPABASE_SERVICE_ROLE_KEY=
