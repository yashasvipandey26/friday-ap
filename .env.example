# Copy to .env and fill in. The app starts without a key, but cannot read invoices until one is set.
ANTHROPIC_API_KEY=

# Optional settings, shown with their defaults.
# FRIDAY_MODEL=claude-sonnet-5-5       # claude-haiku-5-5 is faster and cheaper; re-test the scanned sample if you switch
# FRIDAY_READ_EFFORT=medium            # low, medium or high: how hard the model thinks while reading
# FRIDAY_TOLERANCE_PCT=2.0             # how far over a PO's balance an invoice may go, as % of the PO
# FRIDAY_COMPANY_NAME=Meridian Retail  # used to sign draft messages
# FRIDAY_DATA_DIR=./var                # where the SQLite file and uploaded invoices are kept
# FRIDAY_MAX_RUNS_PER_DAY=300          # stops a public link from running up an AI bill
