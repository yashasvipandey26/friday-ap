# Copy to .env and fill in. Only an AI key is required; everything else falls back to something local.

# --------------------------------------------------------------------------- AI
# Which AI reads the invoices: anthropic (Claude) or gemini (Google).
# Leave it empty to use whichever provider has a key below (Anthropic if both do).
FRIDAY_AI_PROVIDER=

# The key for the provider you chose. Only one is needed.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=                        # from Google AI Studio; GEMINI_API_KEY works too

# The model to use. Leave empty for the provider's default:
#   anthropic -> claude-sonnet-5-5
#   gemini    -> gemini-3.6-flash
# Re-test the scanned sample whenever you switch.
FRIDAY_MODEL=
# Tried only when the main model is busy or rate-limited (a 503 "high demand", say).
# Empty uses the default (gemini-3.5-flash-lite for Gemini, none for Anthropic); "none" turns it off.
FRIDAY_FALLBACK_MODEL=

# --------------------------------------------------------------------------- email (optional)
# A Gmail account just for the app, with 2-step verification on and an app password made at
# https://myaccount.google.com/apppasswords. Without these, upload and the sample inbox still work.
FRIDAY_MAIL_ADDRESS=
FRIDAY_MAIL_APP_PASSWORD=
# Where notes to PO owners go. The PO owners in the sample data aren't real people, so put your
# own address here to receive them.
FRIDAY_PROCUREMENT_EMAIL=
# auto: replies go out as soon as an invoice is decided. manual: they wait for a person to press Send.
# FRIDAY_MAIL_SEND=auto
# FRIDAY_MAIL_POLL_SECONDS=20          # how often the inbox is checked

# --------------------------------------------------------------------------- storage (optional)
# Supabase keeps run history and invoice files across restarts. Without these, a local SQLite file
# and a local folder under FRIDAY_DATA_DIR are used, which a free Render instance wipes on restart.
DATABASE_URL=                          # Supabase > Connect > Session pooler connection string
SUPABASE_URL=                          # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=             # Project Settings > API Keys > secret (or legacy service_role) key
# FRIDAY_STORAGE_BUCKET=invoices       # created automatically, private

# --------------------------------------------------------------------------- tuning
# FRIDAY_READ_EFFORT=medium            # low, medium or high: how hard the model thinks while reading
# FRIDAY_TOLERANCE_PCT=2.0             # how far over a PO's balance an invoice may go, as % of the PO
# FRIDAY_COMPANY_NAME=Meridian Retail  # used to sign emails
# FRIDAY_WORKERS=2                     # invoices checked at the same time
# FRIDAY_DATA_DIR=./var                # where the local database and files live when Supabase isn't set
# FRIDAY_MAX_RUNS_PER_DAY=300          # stops a public link from running up an AI bill
